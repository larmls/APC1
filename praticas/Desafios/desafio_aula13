#include <stdio.h>

int main () {
    float notas[4][4];
    float soma;
    float media;
    int i, j;

    for (i = 0; i < 4; i++) {
        for (j = 0; j < 4; j++) {
        printf("Digite a nota [%d][%d]: ", i, j);
        scanf("%f", &notas[i][j]);
        soma += notas[i][j];

        }
    }

    media = soma / 16;

    printf("Media: %.2f\n", media);

    return 0;
}

